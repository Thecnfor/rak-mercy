# Copy to /etc/default/deyes-stereo-capture and set paths for this robot.
# This file contains no credentials.  It is read by systemd, not a shell profile.
DEYES_WORKSPACE=/home/elephant/deyes_physical_ws
MERCURY_ROS_WORKSPACE=/home/elephant/mercury_x1_ros2
DEYES_CAPTURE_PARAMS=/home/elephant/deyes_physical_ws/src/Deyes/config/stereo/imx219_capture_cpp.yaml
# A physical checkerboard YAML is mandatory before using depth for grasping.
DEYES_CALIB_PATH=/home/elephant/deyes_physical_ws/src/Deyes/config/camera/physical_stereo.yaml
# Leave empty when the system OpenCV is used.  Set only to an already-installed CUDA OpenCV lib dir.
DEYES_OPENCV_LIB=
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
